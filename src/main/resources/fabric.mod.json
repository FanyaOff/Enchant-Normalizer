	"authors": ["FanyaOff"],
	"contact": {
		"sources": "https://github.com/FanyaOff/Enchant-Normalizer"
	},
	"license": "CC0-1.0",
	"icon": "assets/enchaments_normalizer/icon.png",
	"environment": "client",
